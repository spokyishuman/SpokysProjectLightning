<UserControl x:Class="SpokysProjectLightning.Views.ShopPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="32,28,32,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="🛒 Shop" FontSize="32" FontWeight="Bold" FontStyle="Italic"
                           Foreground="{DynamicResource PrimaryBrush}"
                           Effect="{DynamicResource TextGlow}"/>
                <TextBlock Text="Browse premium games available for purchase"
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="2" x:Name="ManageBtn" Content="⚙ Manage"
                    Style="{DynamicResource SecondaryButton}"
                    Padding="12,6" FontSize="12"
                    Click="ManageBtn_Click"
                    Margin="0,0,0,0"/>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="32,16,32,24" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ShopGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="280" Margin="0,0,16,16" CornerRadius="14"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                Background="{DynamicResource CardBrush}"
                                Effect="{DynamicResource CardShadow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="158"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" CornerRadius="14,14,0,0" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding HeaderImage}" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <Border Background="#88000000" VerticalAlignment="Top"
                                                HorizontalAlignment="Left" Margin="10"
                                                CornerRadius="8" Padding="8,4"
                                                Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding DiscountDisplay}" FontSize="13"
                                                       FontWeight="Black" Foreground="#FFD700"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="14,12,14,16">
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" MaxHeight="40"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding PriceDisplay}" FontSize="20"
                                                   FontWeight="ExtraBold"
                                                   Foreground="{DynamicResource PrimaryBrush}"/>
                                        <TextBlock Text="{Binding DonorPriceDisplay}" FontSize="14"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Bottom" Margin="8,0,0,2"/>
                                    </StackPanel>
                                    <TextBlock Text="Steam App" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>

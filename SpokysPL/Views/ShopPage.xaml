<UserControl x:Class="SpokysProjectVercel.Views.ShopPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1200"
       Background="Transparent">
    <UserControl.Resources>
        <DataTemplate x:Key="AdminItemTemplate">
            <Border CornerRadius="6" Padding="10" Margin="0,0,0,4"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                            Background="#264A9F80" Margin="0,0,10,0">
                        <TextBlock Text="{Binding TypeBadge}" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding ItemType}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding AppId}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding PriceDisplay}" FontSize="14" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock FontSize="10" FontWeight="Bold" HorizontalAlignment="Right">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="ACTIVE"/>
                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Active}" Value="False">
                                            <Setter Property="Text" Value="HIDDEN"/>
                                            <Setter Property="Foreground" Value="Crimson"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="32,28,32,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🛒 Shop" FontSize="32" FontWeight="Bold" FontStyle="Italic"
                               Foreground="{DynamicResource PrimaryBrush}"
                               Effect="{DynamicResource TextGlow}"/>
                    <Border x:Name="ItemCountBadge" CornerRadius="10" Padding="8,2"
                            Background="{DynamicResource CardBrush}" Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="ItemCountText" Text="0 items" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Browse and purchase games, accounts, keys &amp; more"
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="ManageBtn" Content="⚙ Manage"
                    Style="{DynamicResource SecondaryButton}"
                    Padding="14,8" FontSize="12"
                    Click="ManageBtn_Click"/>
        </Grid>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="32,16,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Premium card -->
            <Border Grid.Row="0" CornerRadius="10"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Padding="16,12" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#2D2D00" CornerRadius="8" Padding="8"
                            Width="48" Height="48" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="👑" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Go Premium" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Remove ads from Movies, support development, get early access"
                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="👑 Buy Premium — $5.00"
                            FontSize="12" FontWeight="Bold"
                            Padding="16,8" Cursor="Hand"
                            Background="{DynamicResource PrimaryBrush}"
                            Foreground="White" BorderThickness="0"
                            Click="BuyPremium_Click"/>
                </Grid>
            </Border>

            <!-- Filter bar -->
            <Border Grid.Row="1" CornerRadius="10"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Padding="12,10" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" x:Name="FilterAllBtn" CornerRadius="6" Padding="8,4"
                            Background="{DynamicResource SurfaceBrush}" Margin="0,0,8,0" Cursor="Hand"
                            MouseLeftButtonDown="FilterBtn_Click" Tag="">
                        <TextBlock Text="All" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                    </Border>
                    <WrapPanel Grid.Column="1" x:Name="FilterPanel" VerticalAlignment="Center">
                        <Border x:Name="FilterSteamGame" CornerRadius="4" Padding="8,3"
                                Background="{DynamicResource SurfaceBrush}" Margin="0,0,4,0" Cursor="Hand"
                                MouseLeftButtonDown="FilterBtn_Click" Tag="Steam Game">
                            <TextBlock Text="🎮 Games" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                        <Border x:Name="FilterAccount" CornerRadius="4" Padding="8,3"
                                Background="{DynamicResource SurfaceBrush}" Margin="0,0,4,0" Cursor="Hand"
                                MouseLeftButtonDown="FilterBtn_Click" Tag="Account">
                            <TextBlock Text="👤 Accounts" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                        <Border x:Name="FilterKey" CornerRadius="4" Padding="8,3"
                                Background="{DynamicResource SurfaceBrush}" Margin="0,0,4,0" Cursor="Hand"
                                MouseLeftButtonDown="FilterBtn_Click" Tag="Game Key">
                            <TextBlock Text="🔑 Keys" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                        <Border x:Name="FilterService" CornerRadius="4" Padding="8,3"
                                Background="{DynamicResource SurfaceBrush}" Margin="0,0,4,0" Cursor="Hand"
                                MouseLeftButtonDown="FilterBtn_Click" Tag="Service">
                            <TextBlock Text="⚡ Services" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                        <Border x:Name="FilterOther" CornerRadius="4" Padding="8,3"
                                Background="{DynamicResource SurfaceBrush}" Margin="0,0,4,0" Cursor="Hand"
                                MouseLeftButtonDown="FilterBtn_Click" Tag="Other">
                            <TextBlock Text="📦 Other" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </Border>
                    </WrapPanel>
                    <Border Grid.Column="2" CornerRadius="6"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Padding="6,4" Width="180" Margin="8,0,0,0">
                        <TextBox x:Name="SearchBox" FontSize="12" Padding="2,0"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 TextChanged="SearchBox_TextChanged"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Items grid -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ShopGrid">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="260" Margin="0,0,14,14" CornerRadius="12"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Background="{DynamicResource CardBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="140"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- Image area -->
                                    <Border Grid.Row="0" CornerRadius="12,12,0,0" ClipToBounds="True">
                                        <Grid>
                                            <Border Background="{DynamicResource SurfaceBrush}">
                                                <TextBlock Text="{Binding TypeBadge}" FontSize="40"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </Border>
                                            <Image Source="{Binding DisplayImage}" Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <Border Background="#88000000" VerticalAlignment="Top"
                                                    HorizontalAlignment="Left" Margin="8"
                                                    CornerRadius="6" Padding="6,2"
                                                    Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding DiscountDisplay}" FontSize="12"
                                                           FontWeight="Black" Foreground="#FFD700"/>
                                            </Border>
                                            <Border Background="#66000000" VerticalAlignment="Top"
                                                    HorizontalAlignment="Right" Margin="8"
                                                    CornerRadius="6" Padding="6,2">
                                                <TextBlock Text="{Binding ItemType}" FontSize="9"
                                                           Foreground="White" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <!-- Info area -->
                                    <StackPanel Grid.Row="1" Margin="12,10,12,14">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="36"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="32"
                                                   Margin="0,4,0,0"/>
                                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6"
                                                 Padding="10,6" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding PriceDetail}" FontSize="16"
                                                       FontWeight="ExtraBold"
                                                       Foreground="{DynamicResource PrimaryBrush}"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                        <Button Content="Buy Now" FontSize="12" FontWeight="Bold"
                                                Padding="8,4" Margin="0,6,0,0" Cursor="Hand"
                                                Background="{DynamicResource PrimaryBrush}"
                                                Foreground="White" BorderThickness="0"
                                                Click="BuyBtn_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <Border x:Name="EmptyState" Grid.Row="2"
                    Background="{DynamicResource CardBrush}" CornerRadius="12"
                    Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🛍️" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                    <TextBlock x:Name="EmptyStateText" Text="No items available yet."
                               FontSize="15" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<Window x:Class="SpokysProjectVercel.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Password" Height="200" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E2E"
        Foreground="White"
        WindowStyle="SingleBorderWindow">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock x:Name="MessageText" Text="Enter password:" FontSize="14" Margin="0,0,0,12"/>
        <PasswordBox x:Name="PasswordBox" FontSize="16" Padding="6,4"
                     Background="#2A2A3A" Foreground="White" BorderBrush="#555"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelBtn" Content="Cancel" Width="80" Padding="8,6"
                    Background="#555" Foreground="White" Margin="0,0,10,0" Click="CancelBtn_Click"/>
            <Button x:Name="OkBtn" Content="OK" Width="80" Padding="8,6"
                    Background="#4CAF50" Foreground="White" IsDefault="True" Click="OkBtn_Click"/>
        </StackPanel>
    </StackPanel>
</Window>

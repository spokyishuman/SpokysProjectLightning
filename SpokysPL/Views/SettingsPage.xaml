<UserControl x:Class="SpokysProjectVercel.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1200"
      Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" Margin="40,36,40,40">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Width="36" Height="36" CornerRadius="10"
                            Background="{DynamicResource PrimaryBrush}" Opacity="0.15"
                            Effect="{DynamicResource NeonRing}" Margin="0,0,12,0">
                        <TextBlock Text="⚙️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="SETTINGS" FontSize="32" FontWeight="Bold"
                               FontStyle="Italic" Foreground="{DynamicResource PrimaryBrush}"
                               Effect="{DynamicResource TextGlow}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Configure your Steam path and Lightning Tools." FontSize="13"
                           Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,24"/>
            </StackPanel>

            <Border Style="{DynamicResource ModernCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Steam installation path" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource CardForegroundBrush}" Margin="0,0,0,6"/>
                    <TextBlock FontSize="13" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap"
                               Text="Enter the path where Steam is installed so the library can be managed."
                               Margin="0,0,0,14"/>
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="8"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📂" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" x:Name="SteamPathDisplay" FontSize="13" FontFamily="Consolas"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                       Text="Detecting Steam..." TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="🔍 Detect" Style="{DynamicResource AccentButton}"
                                Click="DetectSteam_Click" Margin="0,0,8,0" Padding="12,8"/>
                        <Button Content="📂 Browse" Style="{DynamicResource SecondaryButton}"
                                Click="BrowseSteamPath_Click" Margin="0,0,8,0" Padding="12,8"/>
                    </WrapPanel>
                    <Button Content="💾 Save Changes" Style="{DynamicResource AccentButton}"
                            Click="SaveSteamPath_Click" Padding="12,8" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource ModernCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Theme" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource CardForegroundBrush}" Margin="0,0,0,6"/>
                    <TextBlock FontSize="13" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap"
                               Text="Choose your app theme."
                               Margin="0,0,0,14"/>
                    <ComboBox x:Name="ThemeSelector" SelectedIndex="0"
                              Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource CardBorderBrush}"
                              Padding="10,8" FontSize="13" MaxWidth="280"
                              SelectionChanged="ThemeSelector_SelectionChanged">
                        <ComboBox.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"
                                             Color="{DynamicResource SurfaceColor}"/>
                        </ComboBox.Resources>
                        <ComboBoxItem Content="Dark" Tag="Dark"/>
                        <ComboBoxItem Content="Emerald" Tag="Emerald"/>
                        <ComboBoxItem Content="Midnight Blue" Tag="Midnight Blue"/>
                        <ComboBoxItem Content="Royal Purple" Tag="Royal Purple"/>
                        <ComboBoxItem Content="Light" Tag="Light"/>
                    </ComboBox>
                    <TextBlock x:Name="ThemeStatus" Text="" FontSize="12" Foreground="{DynamicResource PrimaryBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource ModernCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Download Folder" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource CardForegroundBrush}" Margin="0,0,0,6"/>
                    <TextBlock FontSize="13" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap"
                               Text="Where downloaded fixes and archives are saved."
                               Margin="0,0,0,14"/>
                    <Border Background="{DynamicResource CardBrush}" CornerRadius="8"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📁" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" x:Name="DownloadPathDisplay" FontSize="13" FontFamily="Consolas"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                       Text="%USERPROFILE%\Downloads\SpokysPL" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="📂 Browse" Style="{DynamicResource SecondaryButton}"
                                Click="BrowseDownloadPath_Click" Margin="0,0,8,0" Padding="12,8"/>
                        <Button Content="↺ Reset" Style="{DynamicResource SecondaryButton}"
                                Click="ResetDownloadPath_Click" Padding="12,8"/>
                    </WrapPanel>
                    <TextBlock x:Name="DownloadPathStatus" Text="" FontSize="12" Foreground="{DynamicResource PrimaryBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource ModernCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Custom Colors" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource CardForegroundBrush}" Margin="0,0,0,6"/>
                    <TextBlock FontSize="13" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap"
                               Text="Override theme colors. Pick a hex value for any color group below."
                               Margin="0,0,0,14"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
                        <StackPanel x:Name="ColorOptionsPanel"/>
                    </ScrollViewer>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Content="💾 Apply Colors" Style="{DynamicResource AccentButton}"
                                Click="ApplyColors_Click" Padding="14,8" Margin="0,0,8,8"/>
                        <Button Content="↺ Reset All" Style="{DynamicResource SecondaryButton}"
                                Click="ResetAllColors_Click" Padding="14,8" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <TextBlock x:Name="ColorStatus" Text="" FontSize="12" Foreground="{DynamicResource PrimaryBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource ModernCard}" Margin="0,0,0,16" AllowDrop="True"
                    Drop="VideoCard_Drop" DragEnter="VideoCard_DragEnter" DragLeave="VideoCard_DragLeave">
                <StackPanel>
                    <TextBlock Text="Video Background" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource CardForegroundBrush}" Margin="0,0,0,6"/>
                    <TextBlock FontSize="13" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap"
                               Text="Drop an MP4 here or click Browse to select. Place background.mp4 in app folder for auto-play."
                               Margin="0,0,0,14"/>
                    <WrapPanel>
                        <Button x:Name="ToggleBackdropBtn" Content="🎬 Enable" Style="{DynamicResource SecondaryButton}"
                                Click="ToggleBackdrop_Click" Margin="0,0,8,8"/>
                        <Button Content="📂 Browse..." Style="{DynamicResource SecondaryButton}"
                                Click="BrowseBackdrop_Click" Margin="0,0,8,8"/>
                        <Button Content="📁 App folder" Style="{DynamicResource SecondaryButton}"
                                Click="ScanAppFolder_Click" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <StackPanel x:Name="AppVideosPanel" Margin="0,8,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="BackdropStatus" Text="" FontSize="12" Foreground="{DynamicResource PrimaryBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource ModernCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="API Keys" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource CardForegroundBrush}" Margin="0,0,0,6"/>
                    <TextBlock FontSize="13" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap"
                               Margin="0,0,0,14">
                        Enter your own API keys to ensure reliable service.
                        <Hyperlink NavigateUri="https://www.themoviedb.org/settings/api"
                                   RequestNavigate="Hyperlink_RequestNavigate">Get a free TMDB key</Hyperlink>
                    </TextBlock>
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4">TMDB API Key:</TextBlock>
                    <WrapPanel Margin="0,0,0,12">
                        <TextBox x:Name="TmdbApiKeyBox" FontSize="12" Width="300"
                                 VerticalContentAlignment="Center" Padding="6,4"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Background="{DynamicResource SurfaceBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                 Margin="0,0,6,0"/>
                        <Button Content="Save" FontSize="11" Padding="8,3"
                                Style="{DynamicResource SecondaryButton}"
                                Click="SaveTmdbKey_Click"/>
                    </WrapPanel>
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4">OMDb API Key:</TextBlock>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBox x:Name="OmdbApiKeyBox" FontSize="12" Width="300"
                                 VerticalContentAlignment="Center" Padding="6,4"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Background="{DynamicResource SurfaceBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                 Margin="0,0,6,0"/>
                        <Button Content="Save" FontSize="11" Padding="8,3"
                                Style="{DynamicResource SecondaryButton}"
                                Click="SaveOmdbKey_Click"/>
                    </WrapPanel>
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,4">SteamDaddy API Key (get from discord.gg/XN6YGcUF89 #turtle-tool):</TextBlock>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBox x:Name="SteamDaddyApiKeyBox" FontSize="12" Width="300"
                                 VerticalContentAlignment="Center" Padding="6,4"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Background="{DynamicResource SurfaceBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                 Margin="0,0,6,0"/>
                        <Button Content="Save" FontSize="11" Padding="8,3"
                                Style="{DynamicResource SecondaryButton}"
                                Click="SaveSteamDaddyKey_Click"/>
                    </WrapPanel>
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,4">Movie Database Proxy URL (optional — share one TMDB key across all users):</TextBlock>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBox x:Name="MovieProxyUrlBox" FontSize="12" Width="300"
                                 VerticalContentAlignment="Center" Padding="6,4"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Background="{DynamicResource SurfaceBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                 Margin="0,0,6,0"/>
                        <Button Content="Save" FontSize="11" Padding="8,3"
                                Style="{DynamicResource SecondaryButton}"
                                Click="SaveMovieProxyUrl_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="ApiKeyStatus" Text="" FontSize="12" Foreground="{DynamicResource PrimaryBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource ModernCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Updates" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource CardForegroundBrush}" Margin="0,0,0,6"/>
                    <TextBlock FontSize="13" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap"
                               Text="Check for new versions of Spoky's Project Lightning."
                               Margin="0,0,0,14"/>
                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,4">Update manifest URL:</TextBlock>
                    <WrapPanel Margin="0,0,0,8">
                        <TextBox x:Name="UpdateUrlBox" FontSize="12" Width="300"
                                 VerticalContentAlignment="Center" Padding="6,4"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Background="{DynamicResource SurfaceBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                 Margin="0,0,6,0"/>
                        <Button x:Name="SaveUrlBtn" Content="Save" FontSize="11" Padding="8,3"
                                Style="{DynamicResource SecondaryButton}"
                                Click="SaveUpdateUrl_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="UpdateStatus" Text="Current version:" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <Button Content="🔍 Check for Updates" Style="{DynamicResource AccentButton}"
                                Click="CheckForUpdates_Click" Padding="14,8" Margin="0,0,8,8"/>
                        <Button x:Name="DownloadInstallerBtn" Content="📦 Download Installer"
                                Style="{DynamicResource SecondaryButton}"
                                Click="DownloadInstaller_Click" Padding="14,8" Margin="0,0,8,8"/>
                        <Button x:Name="ResetUpdateUrlBtn" Content="Reset to Default"
                                FontSize="11" Padding="10,5"
                                Style="{DynamicResource SecondaryButton}"
                                Click="ResetUpdateUrl_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource ModernCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Install Lightning Tools" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource CardForegroundBrush}" Margin="0,0,0,6"/>
                    <TextBlock FontSize="13" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap"
                               Text="Lightning Tools is the backend you need to play games with Steam. If you already have SteamTools installed, you don't need to install it again."
                               Margin="0,0,0,14"/>
                    <WrapPanel>
                        <Button x:Name="InstallToolsBtn" Content="📥 Install" Style="{DynamicResource AccentButton}"
                                Click="InstallTools_Click" Margin="0,0,8,8"/>
                        <Button Content="🗑️ Remove all games" Style="{DynamicResource SecondaryButton}"
                                Click="RemoveAllGames_Click" Margin="0,0,8,8"/>
                        <Button x:Name="UninstallToolsBtn" Content="✕ Uninstall" Style="{DynamicResource SecondaryButton}"
                                Click="UninstallTools_Click" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <TextBlock x:Name="ToolsStatus" Text="" FontSize="12" Foreground="{DynamicResource PrimaryBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="VersionLabel" Text="Project Vercel"
                       FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>



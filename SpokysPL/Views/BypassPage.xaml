<UserControl x:Class="SpokysProjectLightning.Views.BypassPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:SpokysProjectLightning.Models"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1200"
      Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header + filters (zip: flex flex-col lg:flex-row lg:items-center lg:justify-between) -->
        <StackPanel Grid.Row="0" Margin="40,36,40,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Border Width="36" Height="36" CornerRadius="10"
                        Background="#264ADE80" Margin="0,0,12,0"
                        Effect="{DynamicResource NeonRing}">
                    <TextBlock Text="🔧" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="BYPASSES" FontSize="32" FontWeight="Bold"
                           FontStyle="Italic" Foreground="{DynamicResource PrimaryBrush}"
                           Effect="{DynamicResource TextGlow}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Category filters + search (zip: flex items-center gap-3) -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" MaxWidth="500">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="All" Style="{DynamicResource AccentButton}" 
                                Margin="0,0,6,0" Click="FilterCategory_Click" Tag="All" Height="32"/>
                        <Button Content="UBISOFT" Style="{DynamicResource SecondaryButton}"
                                Margin="0,0,4,0" Click="FilterCategory_Click" Tag="UBISOFT" Height="32"/>
                        <Button Content="EA" Style="{DynamicResource SecondaryButton}"
                                Margin="0,0,4,0" Click="FilterCategory_Click" Tag="EA" Height="32"/>
                        <Button Content="Rockstar" Style="{DynamicResource SecondaryButton}"
                                Margin="0,0,4,0" Click="FilterCategory_Click" Tag="ROCKSTAR" Height="32"/>
                        <Button Content="DENUVO" Style="{DynamicResource SecondaryButton}"
                                Margin="0,0,4,0" Click="FilterCategory_Click" Tag="DENUVO" Height="32"/>
                        <Button Content="PlayStation" Style="{DynamicResource SecondaryButton}"
                                Margin="0,0,4,0" Click="FilterCategory_Click" Tag="PlayStation" Height="32"/>
                        <Button Content="Other" Style="{DynamicResource SecondaryButton}"
                                Margin="0,0,4,0" Click="FilterCategory_Click" Tag="OTHERS" Height="32"/>
                        <Button Content="Fixes" Style="{DynamicResource SecondaryButton}"
                                Margin="0,0,4,0" Click="FilterCategory_Click" Tag="Fixes" Height="32"/>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Column="2" Background="#B31B2D22" CornerRadius="8"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Margin="10,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBox Grid.Column="1" x:Name="SearchBox" Width="180"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontSize="13" Padding="6,8,10,8"
                                 Text="Search games..."
                                 GotFocus="SearchBox_GotFocus"
                                 KeyDown="SearchBox_KeyDown"/>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock Text="Pick a game to apply its community fix and get it running smoothly."
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0"/>
        </StackPanel>

        <!-- Games Grid (zip: grid grid-cols-2/3/4 gap-4) -->
        <ScrollViewer Grid.Row="1" Margin="40,16,40,30">
            <ItemsControl x:Name="GamesList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- GameCard (zip-style: rounded-xl border border-primary/20 bg-card/70) -->
                        <Border Background="#B31B2D22" CornerRadius="12"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                Width="220" Margin="0,0,14,14" Cursor="Hand"
                                MouseLeftButtonUp="GameCard_Click" Tag="{Binding}">
                            <Border.Resources>
                                <Style TargetType="Border" x:Key="ModernCard"/>
                            </Border.Resources>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!-- Cover image area (zip: aspect-[16/9]) -->
                                <Border Grid.Row="0" CornerRadius="12,12,0,0" ClipToBounds="True"
                                        Height="124" Background="#141F19">
                                    <Grid>
                                        <Image Source="{Binding HeaderUrl}" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality">
                                            <Image.Triggers>
                                                <EventTrigger RoutedEvent="Image.ImageFailed">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                                                <DiscreteObjectKeyFrame Value="{x:Static Visibility.Collapsed}" KeyTime="0"/>
                                                            </ObjectAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Image.Triggers>
                                        </Image>
                                        <Border VerticalAlignment="Top" HorizontalAlignment="Left"
                                                Background="#B3141F19" CornerRadius="6"
                                                Padding="8,3" Margin="8,8,0,0">
                                            <TextBlock Text="{Binding FixName}" FontSize="9" FontWeight="Black"
                                                       Foreground="{DynamicResource PrimaryBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <!-- Game info (zip: p-3) -->
                                <StackPanel Grid.Row="1" Margin="14,12,14,14">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding AppId, StringFormat='App {0}'}" FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                                    <!-- Required programs badges -->
                                    <ItemsControl ItemsSource="{Binding RequiredPrograms}" Margin="0,6,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#4DFFB020" CornerRadius="4"
                                                        Padding="5,1" Margin="0,0,4,4">
                                                    <TextBlock Text="{Binding}" FontSize="9" Foreground="#0F1A12" FontWeight="Bold"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- Actions -->
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button Content="🔧 Apply Fix"
                                                Style="{DynamicResource AccentButton}"
                                                Tag="{Binding AppId}"
                                                Click="ApplyFix_Click"
                                                Padding="10,6" FontSize="11" Margin="0,0,4,4"/>
                                        <Button Content="Steam" Style="{DynamicResource SecondaryButton}"
                                                Tag="{Binding AppId}"
                                                Click="LaunchSteam_Click"
                                                Padding="8,6" FontSize="10"
                                                Visibility="{Binding LaunchSteam, Converter={StaticResource BoolToVis}}"
                                                Margin="0,0,4,4"/>
                                        <Button Content="EXE" Style="{DynamicResource SecondaryButton}"
                                                Tag="{Binding AppId}"
                                                Click="LaunchExe_Click"
                                                Padding="8,6" FontSize="10"
                                                Visibility="{Binding LaunchExe, Converter={StaticResource BoolToVis}}"
                                                Margin="0,0,0,4"/>
                                    </WrapPanel>
                                    <!-- Error notes -->
                                    <ItemsControl ItemsSource="{Binding Errors}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="10"
                                                           Foreground="{DynamicResource ErrorBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>



<UserControl x:Class="SpokysProjectLightning.Views.OnlineFixPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1200"
      Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="25,20,25,10">
            <TextBlock FontSize="28" FontWeight="Bold" Text="🔧 Online Fixes" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Text="Browse, download, and install online fixes from Online-Fix.me" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Download Manager Panel -->
        <Border x:Name="DownloadPanel" Grid.Row="1" Background="{DynamicResource CardBrush}" 
                CornerRadius="12" Padding="20" Margin="25,0,25,10"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Download Header -->
                <Grid Grid.Row="0">
                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="📥 Download Manager"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Button Content="✕" HorizontalAlignment="Right" 
                            Click="CloseDownloadPanel_Click"
                            Style="{DynamicResource SecondaryButton}" 
                            Padding="8,2" FontSize="11"/>
                </Grid>
                
                <!-- File Name -->
                <TextBlock Grid.Row="1" x:Name="DownloadFileName" FontSize="13" 
                           Foreground="{DynamicResource TextPrimaryBrush}" 
                           Margin="0,8,0,0" TextTrimming="CharacterEllipsis"
                           Text="No active download"/>
                
                <!-- Progress Bar -->
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Height="10">
                        <Border x:Name="DownloadProgressBar" Background="{DynamicResource AccentBrush}" 
                                CornerRadius="6" HorizontalAlignment="Left" Width="0"
                                RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1"/>
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                    <TextBlock x:Name="DownloadPercent" FontSize="11" 
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="0,0,0,0" Text="0%"/>
                </Grid>
                
                <!-- Download Stats -->
                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="DownloadSpeed" FontSize="12" 
                               Foreground="{DynamicResource TextSecondaryBrush}" Text="Ready"/>
                    <TextBlock Grid.Column="1" x:Name="DownloadSize" FontSize="12" 
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="15,0,0,0" Text=""/>
                    <Button Grid.Column="2" Content="📂 Open Folder" 
                            Style="{DynamicResource SecondaryButton}" 
                            Click="OpenDownloadsFolder_Click"
                            Padding="10,4" FontSize="11" Margin="10,0,0,0"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Search & Actions -->
        <StackPanel Grid.Row="2" Margin="25,0,25,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" 
                             Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" 
                             Padding="12,10" Text="Search games..." 
                             GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus" 
                             KeyDown="SearchBox_KeyDown"/>
                </Border>
                <Button Grid.Column="1" x:Name="SearchBtn" Content="🔍 Search" 
                        Style="{DynamicResource AccentButton}" Margin="10,0,0,0" Click="SearchBtn_Click"/>
                <Button Grid.Column="2" x:Name="RefreshBtn" Content="🔄 Refresh" 
                        Style="{DynamicResource SecondaryButton}" Margin="10,0,0,0" Click="RefreshBtn_Click"/>
                <Button Grid.Column="3" x:Name="AddFixBtn" Content="➕ Add Fix" 
                        Style="{DynamicResource AccentButton}" Margin="10,0,0,0" Click="AddFix_Click"
                        ToolTip="Add a fix from an online-fix.me URL"/>
            </Grid>
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"/>
            
            <!-- Progress bar for scraping -->
            <Border x:Name="ProgressBorder" Background="{DynamicResource SurfaceBrush}" 
                    CornerRadius="6" Height="6" Margin="0,8,0,0" Visibility="Collapsed">
                <Border x:Name="ProgressBar" Background="{DynamicResource AccentBrush}" 
                        CornerRadius="6" HorizontalAlignment="Left" Width="0"/>
            </Border>
        </StackPanel>

        <!-- Categories -->
        <ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" Margin="25,0,25,10">
            <WrapPanel x:Name="CategoryPanel"/>
        </ScrollViewer>

        <!-- Games Grid -->
        <ScrollViewer Grid.Row="4" Margin="25,0,25,15">
            <ItemsControl x:Name="GamesList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBrush}" CornerRadius="12" 
                                Padding="12" Margin="0,0,16,16" Width="200" Cursor="Hand"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                MouseLeftButtonUp="GameCard_Click" Tag="{Binding}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="140"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Game Image -->
                                <Border Grid.Row="0" CornerRadius="10" ClipToBounds="True">
                                    <Grid>
                                        <Border Background="{DynamicResource SurfaceBrush}">
                                            <TextBlock Text="🎮" FontSize="40"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Border>
                                        <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <Border Background="#CC000000" CornerRadius="6"
                                                Padding="6,3" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Category}" FontSize="10" 
                                                       Foreground="White" FontWeight="SemiBold"/>
                                        </Border>
                                        <Border Background="#66000000" HorizontalAlignment="Center" 
                                                VerticalAlignment="Center" CornerRadius="20"
                                                Width="40" Height="40" Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="✅" FontSize="18" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                
                                <!-- Game Info -->
                                <StackPanel Grid.Row="1" Margin="8,10,8,12">
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" MaxHeight="36"/>
                                    <TextBlock Text="{Binding FileSize}" FontSize="10"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"
                                               Visibility="{Binding FileSize, Converter={StaticResource StringNotEmpty}}"/>
                                    <Button Content="⬇️ Download Options" 
                                            Style="{DynamicResource AccentButton}" 
                                            Tag="{Binding}" Click="ShowDownloadOptions_Click"
                                            Margin="0,8,0,0" Padding="8,4" FontSize="11"
                                            HorizontalAlignment="Stretch"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>



<UserControl x:Class="SpokysProjectLightning.Views.ToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1200"
      Background="Transparent">
    <Grid Margin="40,36,40,32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Tool list -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Width="32" Height="32" CornerRadius="8"
                            Background="#264ADE80" Margin="0,0,10,0"
                            Effect="{DynamicResource NeonRing}">
                        <TextBlock Text="🔧" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="TOOLS" FontSize="26" FontWeight="Bold"
                               FontStyle="Italic" Foreground="{DynamicResource PrimaryBrush}"
                               Effect="{DynamicResource TextGlow}" VerticalAlignment="Center"/>
                </StackPanel>

                <ItemsControl x:Name="ToolsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource ModernCardHover}"
                                    Padding="14" Margin="0,0,0,8" Cursor="Hand"
                                    Tag="{Binding Url}"
                                    PreviewMouseDown="ToolCard_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                            Background="#264ADE80" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Icon}" FontSize="15"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                                   Foreground="{DynamicResource CardForegroundBrush}"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="32"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- DIVIDER -->
        <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource BorderBrush}" Margin="16,0"/>

        <!-- RIGHT: WebView2 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Border Grid.Row="0" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="8,6" CornerRadius="8,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="◀" FontSize="12" Width="28" Height="28"
                            Style="{DynamicResource IconNavButton}" Click="GoBack_Click"
                            ToolTip="Back" Margin="0,0,4,0"/>
                    <Button Grid.Column="1" Content="▶" FontSize="12" Width="28" Height="28"
                            Style="{DynamicResource IconNavButton}" Click="GoForward_Click"
                            ToolTip="Forward" Margin="0,0,4,0"/>
                    <Button Grid.Column="2" Content="🔄" FontSize="12" Width="28" Height="28"
                            Style="{DynamicResource IconNavButton}" Click="Refresh_Click"
                            ToolTip="Refresh" Margin="0,0,8,0"/>
                    <Border Grid.Column="3" Background="{DynamicResource BackgroundBrush}"
                            CornerRadius="4" Padding="8,4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBlock x:Name="UrlBar" Text="Select a tool to open" FontSize="12"
                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </Border>
                    <Button Grid.Column="4" Content="🌐" FontSize="12" Width="28" Height="28"
                            Style="{DynamicResource IconNavButton}" Click="OpenExternal_Click"
                            ToolTip="Open in external browser" Margin="6,0,0,0"/>
                </Grid>
            </Border>

            <!-- WebView2 -->
            <Border Grid.Row="1" CornerRadius="0,0,8,8" ClipToBounds="True"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <wv2:WebView2 x:Name="ToolBrowser" Visibility="Collapsed"/>
                    <Border x:Name="Placeholder" Background="{DynamicResource CardBrush}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🔧" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Select a tool from the left panel" FontSize="16"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Web pages will open here inside the app" FontSize="12"
                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>



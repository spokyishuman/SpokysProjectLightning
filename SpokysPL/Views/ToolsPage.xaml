<UserControl x:Class="SpokysProjectVercel.Views.ToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1200"
      Background="Transparent">
    <Grid Margin="40,36,40,32">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Width="32" Height="32" CornerRadius="8"
                            Background="#264ADE80" Margin="0,0,10,0"
                            Effect="{DynamicResource NeonRing}">
                        <TextBlock Text="🔧" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="TOOLS" FontSize="26" FontWeight="Bold"
                               FontStyle="Italic" Foreground="{DynamicResource PrimaryBrush}"
                               Effect="{DynamicResource TextGlow}" VerticalAlignment="Center"/>
                    <Border x:Name="ModeBadge" CornerRadius="4" Padding="6,2"
                            Background="{DynamicResource PrimaryBrush}" Margin="10,0,0,0"
                            ToolTip="Current mode — change in sidebar">
                        <TextBlock x:Name="ModeBadgeText" Text="⚡ LC" FontSize="9" FontWeight="Bold"
                                   Foreground="White" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <TextBlock Text="Click a tool to open it in your browser:" FontSize="12"
                           Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,12"/>

                <ItemsControl x:Name="ToolsList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource ModernCardHover}"
                                    Padding="14" Margin="0,0,0,8" Cursor="Hand"
                                    Tag="{Binding Url}"
                                    MouseLeftButtonDown="ToolCard_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                            Background="#264ADE80" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Icon}" FontSize="15"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                                   Foreground="{DynamicResource CardForegroundBrush}"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                   Foreground="{DynamicResource MutedForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="32"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="↗" FontSize="14"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>



<UserControl x:Class="SpokysProjectVercel.Views.ToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1200"
      Background="Transparent">
    <Grid Margin="40,36,40,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Width="32" Height="32" CornerRadius="8"
                    Background="#264ADE80" Margin="0,0,10,0"
                    Effect="{DynamicResource NeonRing}">
                <TextBlock Text="&#x1F527;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="TOOLS" FontSize="26" FontWeight="Bold"
                       FontStyle="Italic" Foreground="{DynamicResource PrimaryBrush}"
                       Effect="{DynamicResource TextGlow}" VerticalAlignment="Center"/>
            <Border x:Name="ModeBadge" CornerRadius="4" Padding="6,2"
                    Background="{DynamicResource PrimaryBrush}" Margin="10,0,0,0"
                    ToolTip="Current mode - change in sidebar">
                <TextBlock x:Name="ModeBadgeText" Text="&#x26A1; LC" FontSize="9" FontWeight="Bold"
                           Foreground="White" VerticalAlignment="Center"/>
            </Border>
        </StackPanel>

        <!-- Main content -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="ToolListView" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Click a tool to launch it in-app:" FontSize="12"
                               Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,12"/>
                    <ItemsControl x:Name="ToolsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource ModernCardHover}"
                                        Padding="14" Margin="0,0,0,8" Cursor="Hand"
                                        Tag="{Binding Url}"
                                        MouseLeftButtonDown="ToolCard_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                                Background="#264ADE80" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Icon}" FontSize="15"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                                       Foreground="{DynamicResource CardForegroundBrush}"/>
                                            <TextBlock Text="{Binding Description}" FontSize="11"
                                                       Foreground="{DynamicResource MutedForegroundBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxHeight="32"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="&#x25B6;" FontSize="14"
                                                   Foreground="{DynamicResource PrimaryBrush}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Popular Games Section -->
                    <Border Style="{DynamicResource ModernCard}" Padding="16" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Popular Games (SteamRIP and DODI)" FontSize="17" FontWeight="Bold"
                                           Foreground="{DynamicResource CardForegroundBrush}" Margin="0,0,0,6"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                                    <ComboBox x:Name="PopularGamesFilter" Width="160" Margin="0,0,8,0"
                                              FontSize="12" Padding="6,2"
                                              SelectionChanged="PopularGamesFilter_SelectionChanged">
                                        <ComboBoxItem Content="All Sources" IsSelected="True"/>
                                        <ComboBoxItem Content="SteamRIP"/>
                                        <ComboBoxItem Content="DODI Repacks"/>
                                    </ComboBox>
                                    <Button Content="Refresh" Padding="10,4" FontSize="11"
                                            Style="{DynamicResource SecondaryButton}"
                                            Click="RefreshPopularGames_Click"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="PopularGamesStatus" Text="Loading popular games..." FontSize="11"
                                       Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,10"/>
                            <ItemsControl x:Name="PopularGamesList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{DynamicResource ModernCardHover}" Width="180" Height="220" Margin="0,0,10,10" Cursor="Hand"
                                                Tag="{Binding Url}"
                                                MouseLeftButtonDown="PopularGameCard_Click">
                                            <StackPanel>
                                                <Border Height="120" CornerRadius="8,8,0,0"
                                                        Background="#1A2196F3" Margin="-1"
                                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,1,1,0">
                                                    <TextBlock Text="{Binding Icon}" FontSize="48"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Margin="8,8,8,8">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold"
                                                               Foreground="{DynamicResource CardForegroundBrush}"
                                                               TextTrimming="CharacterEllipsis" MaxHeight="36"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Source}" FontSize="10"
                                                               Foreground="{DynamicResource PrimaryBrush}"
                                                               Margin="0,2,0,0"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <TextBlock Text="Size: " FontSize="9" Foreground="{DynamicResource MutedForegroundBrush}"/>
                                                        <TextBlock Text="{Binding Size}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource CardForegroundBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="Click to download" FontSize="9" FontStyle="Italic"
                                                               Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Add Game Section -->
                    <Border Style="{DynamicResource ModernCard}" Padding="16" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Add Game Download" FontSize="17" FontWeight="Bold"
                                       Foreground="{DynamicResource CardForegroundBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="Paste a SteamRIP or DODI Repack URL to add a game download." FontSize="12"
                                       Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1A2196F3" CornerRadius="6" Padding="8,6" Margin="0,0,8,0"
                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="SourceIcon" Text="&#x1F310;" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SourceLabel" Text="Auto" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" CornerRadius="4"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        Background="{DynamicResource SurfaceBrush}">
                                    <TextBox x:Name="GameUrlBox"
                                             FontSize="13" Padding="8,6"
                                             Background="Transparent"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderThickness="0"
                                             KeyDown="GameUrlBox_KeyDown"/>
                                </Border>
                                <Button Grid.Column="2" Content="Add Game" Margin="6,0,0,0"
                                        Padding="12,6" FontSize="12"
                                        Style="{DynamicResource AccentButton}"
                                        Click="AddGameBtn_Click"/>
                            </Grid>
                            <TextBlock x:Name="GameUrlStatus" Text="" FontSize="12"
                                       Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Embedded WebView2 view (shown when tool is opened) -->
            <Grid x:Name="WebViewPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource CardBrush}" Padding="8,6"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="&#x2190; Back to Tools" Padding="10,4"
                                FontSize="12" Style="{DynamicResource SecondaryButton}"
                                Click="WebViewBack_Click"/>
                        <TextBlock Grid.Column="1" x:Name="WebViewTitle" Text="" FontSize="13"
                                   FontWeight="Bold" Foreground="{DynamicResource CardForegroundBrush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <Button Grid.Column="2" Content="&#x2197; Open in Browser" Padding="10,4"
                                FontSize="12" Style="{DynamicResource SecondaryButton}"
                                Click="WebViewExternal_Click"/>
                    </Grid>
                </Border>
                <wv2:WebView2 Grid.Row="1" x:Name="ToolWebView"/>
            </Grid>
        </Grid>

        <!-- Download progress overlay -->
        <Border x:Name="DownloadOverlay" Grid.Row="1" Grid.RowSpan="3"
                Background="#CC000000" Visibility="Collapsed"
                VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Border CornerRadius="12" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    Padding="24" Width="400" Height="Auto"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="DownloadTitle" Text="Downloading..." FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource CardForegroundBrush}" HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>
                    <ProgressBar x:Name="DownloadProgress" Height="6" Maximum="100"
                                 Foreground="{DynamicResource PrimaryBrush}"
                                 Background="{DynamicResource SurfaceBrush}"/>
                    <TextBlock x:Name="DownloadStatus" Text="" FontSize="12"
                               Foreground="{DynamicResource MutedForegroundBrush}"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="3" Text="Spoky's Project Vercel &#xB7; Tools"
                   FontSize="10" Foreground="{DynamicResource MutedForegroundBrush}"
                   HorizontalAlignment="Center" Margin="0,12,0,0"/>
    </Grid>
</UserControl>
<UserControl x:Class="SpokysProjectVercel.Views.FixesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:SpokysProjectVercel.Views"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1200"
      Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="40,36,40,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="10"
                                Background="#264ADE80" Margin="0,0,12,0"
                                Effect="{DynamicResource NeonRing}">
                            <TextBlock Text="🛡️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="FIXES" FontSize="32" FontWeight="Bold"
                                   FontStyle="Italic" Foreground="{DynamicResource PrimaryBrush}"
                                   Effect="{DynamicResource TextGlow}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#B31B2D22" CornerRadius="8"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}"/>
                            <TextBox Grid.Column="1" x:Name="SearchBox" Width="180"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     FontSize="13" Padding="6,8,10,8"
                                     TextChanged="SearchBox_TextChanged"/>
                        </Grid>
                    </Border>
                    <Border x:Name="SteamDaddyBadge" Background="#1A2196F3" CornerRadius="6"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            Padding="10,6" Margin="10,0,0,0" Visibility="Collapsed"
                            ToolTip="SteamDaddy API key is set (ContraryCDN)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🍼" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="SteamDaddyStatusText" Text="SD"
                                       FontSize="11" Foreground="#64B5F6"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="RestartSteamBtn" Content="🔄 Steam"
                            Style="{DynamicResource SecondaryButton}"
                            Padding="10,6" FontSize="11" Margin="10,0,0,0"
                            Click="RestartSteam_Click"
                            ToolTip="Restart Steam to apply changes"/>
                    <StackPanel x:Name="DiscordLoginPanel" Orientation="Horizontal" Margin="10,0,0,0">
                        <Button x:Name="DiscordLoginBtn" Content="🔑 Login with Discord"
                                Style="{DynamicResource SecondaryButton}"
                                Padding="10,6" FontSize="11"
                                Click="DiscordLogin_Click"
                                Visibility="Visible"/>
                        <Border x:Name="SignedInPanel" Visibility="Collapsed"
                                Background="#B3141F19" CornerRadius="6"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                Padding="10,6" Cursor="Hand"
                                MouseLeftButtonUp="SignedInPanel_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="SignedInIcon" Text="✅" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="SignedInText" Text="Signed in with Discord"
                                           FontSize="11" Foreground="{DynamicResource PrimaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <TextBlock Text="Install manifests + apply fixes to play games on Steam."
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="40,16,40,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="GamesList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:FixGame}">
                        <Border Style="{DynamicResource ModernCardHover}" Width="220" Margin="0,0,14,14" Padding="0">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="📦 Manifest" Tag="{Binding}" Click="ContextManifest_Click"/>
                                    <MenuItem Header="🛠️ Fix" Tag="{Binding}" Click="ContextFix_Click"/>
                                    <MenuItem Header="🌐 Open Steam Page" Tag="{Binding AppId}" Click="ContextOpenSteam_Click"/>
                                    <MenuItem Header="📋 Copy App ID" Tag="{Binding AppId}" Click="ContextCopyId_Click"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="124"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" CornerRadius="12,12,0,0" ClipToBounds="True"
                                        Background="{DynamicResource SurfaceBrush}">
                                    <Grid>
                                        <Border Background="{DynamicResource SurfaceBrush}">
                                            <TextBlock Text="🎮" FontSize="30"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Border>
                                        <Image Source="{Binding CoverUrl}" Stretch="UniformToFill"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <WrapPanel VerticalAlignment="Top" HorizontalAlignment="Left"
                                                   Margin="8,8,8,0">
                                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="5"
                                                    Padding="7,2" Margin="0,0,4,4" Opacity="0.8">
                                                <TextBlock Text="{Binding Tag}" FontSize="9" FontWeight="Black"
                                                           Foreground="White"/>
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding SecondaryBadges}" Margin="0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource SurfaceBrushLight}" CornerRadius="5"
                                                                Padding="6,2" Margin="0,0,4,4"
                                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                            <TextBlock Text="{Binding}" FontSize="8" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </WrapPanel>
                                    
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="14,12,14,14">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold"
                                               Foreground="{DynamicResource CardForegroundBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding AppId, StringFormat='App {0}'}" FontSize="11"
                                               Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,3,0,0"/>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="📦 Manifest"
                                                Style="{DynamicResource SecondaryButton}"
                                                Tag="{Binding}"
                                                Click="InstallManifest_Click"
                                                Padding="6,6" FontSize="10"/>
                                        <Button Grid.Column="2" Content="🛠️ Fix"
                                                Style="{DynamicResource AccentButton}"
                                                Tag="{Binding}"
                                                Click="ApplyFix_Click"
                                                Padding="6,6" FontSize="10"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" x:Name="PaginationPanel" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="40,10,40,30"/>
    </Grid>
</UserControl>



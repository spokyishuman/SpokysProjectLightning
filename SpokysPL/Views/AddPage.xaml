<UserControl x:Class="SpokysProjectVercel.Views.AddPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1000"
      Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="SearchContainer" TargetType="Border">
            <Setter Property="Background" Value="#B31B2D22"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="ExtraBold"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="32,30,32,30">
        <StackPanel MaxWidth="1152">

            <StackPanel Margin="0,0,0,24">
                <TextBlock FontSize="30" FontWeight="ExtraBold" FontStyle="Italic"
                           Text="ADD A GAME"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Effect="{DynamicResource TextGlow}"/>
                <TextBlock FontSize="13" Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,8,0,0">
                    Enter an App ID, paste a Steam link, or search by game name.
                </TextBlock>
            </StackPanel>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SearchContainer}"
                        BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="AppIdBox" Background="Transparent"
                                 BorderThickness="0" VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Text="Enter App ID..."
                                 GotFocus="AppIdBox_GotFocus" KeyDown="AppIdBox_KeyDown"/>
                        <Button Grid.Column="1" x:Name="AddGameBtn" Style="{DynamicResource AccentButton}"
                                Padding="14,8" Click="AddGameBtn_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕" Margin="0,0,6,0"/>
                                <TextBlock Text="Add Game"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource SearchContainer}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" x:Name="SearchBox" Background="Transparent"
                                 BorderThickness="0" VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 Text="Search games..."
                                 GotFocus="SearchBox_GotFocus"
                                 LostFocus="SearchBox_LostFocus"
                                 TextChanged="SearchBox_TextChanged"
                                 KeyDown="SearchBox_KeyDown"/>
                        <TextBlock Grid.Column="2" x:Name="SearchSpinner" Text="⏳" FontSize="14"
                                   VerticalAlignment="Center" Margin="4,0,0,0" Visibility="Collapsed"
                                   Foreground="{DynamicResource PrimaryBrush}">
                            <TextBlock.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" Angle="0"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel x:Name="ResultsSection" Visibility="Collapsed" Margin="0,32,0,0">
                    <Border Style="{DynamicResource SectionHeaderBar}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="18" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" x:Name="ResultsCountText" Style="{StaticResource SectionTitle}"
                               Effect="{DynamicResource TextGlow}"/>
                    </Grid>
                </Border>
                <ItemsControl x:Name="ResultsGrid" Margin="0,12,0,0" Visibility="Visible">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource ModernCardHover}" Width="160" Margin="0,0,12,12" Padding="0" Cursor="Hand"
                                    MouseLeftButtonUp="SearchResult_Click" Tag="{Binding}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="📥 Install" Tag="{Binding}" Click="ContextInstall_Click"/>
                                        <MenuItem Header="🌐 Open Steam Page" Tag="{Binding AppId}" Click="ContextOpenSteam_Click"/>
                                        <MenuItem Header="📋 Copy App ID" Tag="{Binding AppId}" Click="ContextCopyId_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="120"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" CornerRadius="10,10,0,0" ClipToBounds="True" Background="#141F19">
                                        <Grid>
                                            <Border Background="#141F19">
                                                <TextBlock Text="🎮" FontSize="26"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Image Source="{Binding CoverUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Row="1" Margin="10,8,10,10">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource CardForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="36"/>
                                        <TextBlock Text="{Binding AppId, StringFormat='App {0}'}" FontSize="10"
                                                   Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="NoResultsText" FontSize="13" Foreground="{DynamicResource MutedForegroundBrush}"
                           Margin="0,16,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel x:Name="DefaultSection" Margin="0,32,0,0">
                <StackPanel Margin="0,0,0,32">
                    <Border Style="{DynamicResource SectionHeaderBar}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📈" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource SectionTitle}" Text="RECOMMENDED"
                                       Effect="{DynamicResource TextGlow}"/>
                            <TextBlock Grid.Column="2" Text="Click any game to install manifest + fix"
                                       FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ItemsControl x:Name="TopSellersGrid" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource ModernCardHover}" Width="160" Margin="0,0,12,12" Padding="0"
                                        Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="TopSeller_Click">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="📥 Install" Tag="{Binding}" Click="ContextInstall_Click"/>
                                            <MenuItem Header="🌐 Open Steam Page" Tag="{Binding AppId}" Click="ContextOpenSteam_Click"/>
                                            <MenuItem Header="📋 Copy App ID" Tag="{Binding AppId}" Click="ContextCopyId_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="120"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" CornerRadius="10,10,0,0" ClipToBounds="True" Background="#141F19">
                                            <Grid>
                                                <Border Background="#141F19">
                                                    <TextBlock Text="🎮" FontSize="26"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Image Source="{Binding CoverUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="10,8,10,10">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource CardForegroundBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxHeight="36"/>
                                            <TextBlock Text="{Binding AppId, StringFormat='App {0}'}" FontSize="10"
                                                       Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Margin="0,0,0,32">
                    <Border Style="{DynamicResource SectionHeaderBar}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="✨" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource SectionTitle}" Text="TRENDING"
                                       Effect="{DynamicResource TextGlow}"/>
                            <TextBlock Grid.Column="2" Text="Powered by Steam"
                                       FontSize="11" Foreground="{DynamicResource MutedForegroundBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ItemsControl x:Name="NewReleasesGrid" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{DynamicResource ModernCardHover}" Width="160" Margin="0,0,12,12" Padding="0"
                                        Cursor="Hand" Tag="{Binding}" MouseLeftButtonUp="NewRelease_Click">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="📥 Install" Tag="{Binding}" Click="ContextInstall_Click"/>
                                            <MenuItem Header="🌐 Open Steam Page" Tag="{Binding AppId}" Click="ContextOpenSteam_Click"/>
                                            <MenuItem Header="📋 Copy App ID" Tag="{Binding AppId}" Click="ContextCopyId_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="120"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" CornerRadius="10,10,0,0" ClipToBounds="True" Background="#141F19">
                                            <Grid>
                                                <Border Background="#141F19">
                                                    <TextBlock Text="🎮" FontSize="26"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <Image Source="{Binding CoverUrl}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="10,8,10,10">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource CardForegroundBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxHeight="36"/>
                                            <TextBlock Text="{Binding Tag}" FontSize="10"
                                                       Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="0,40,0,0">
                <Border Style="{DynamicResource SectionHeaderBar}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📁" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource SectionTitle}" Text="ALREADY HAVE THE FILES?"
                                       Effect="{DynamicResource TextGlow}"/>
                    </Grid>
                </Border>

                <Border x:Name="DropZone" Style="{DynamicResource ModernCard}" Padding="24"
                        Margin="0,16,0,0" AllowDrop="True" Cursor="Hand"
                        Drop="DropZone_Drop" DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12"
                                Background="{DynamicResource SurfaceBrush}" Margin="0,0,20,0">
                            <TextBlock Text="📥" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedForegroundBrush}"/>
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Drop .lua, .manifest or .zip files here"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource CardForegroundBrush}"/>
                            <TextBlock Text="They're placed into the right Steam folders automatically."
                                       FontSize="12" Foreground="{DynamicResource MutedForegroundBrush}"
                                       Margin="0,4,0,0"/>
                            <Button Content="📂  Browse files..." Style="{DynamicResource SecondaryButton}"
                                    Margin="0,12,0,0" Padding="12,6" FontSize="12" Height="32"
                                    Click="BrowseFiles_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>



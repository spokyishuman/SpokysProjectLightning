<UserControl x:Class="SpokysProjectVercel.Views.LibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1200"
      Background="{DynamicResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="30,30,30,10">
            <TextBlock FontSize="28" FontWeight="Bold" 
                       Text="📋 Install Manifest Library"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="Recommended paid games from Steam - Search and get manifests from fares.top"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Search -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" 
                CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" Padding="5" Height="45"
                Margin="30,0,30,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="SearchBox"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         FontSize="14" VerticalAlignment="Center"
                         Text="Search Steam library for a game..."
                         GotFocus="SearchBox_GotFocus"
                         KeyDown="SearchBox_KeyDown"/>
                <Button Grid.Column="1" x:Name="SearchButton"
                        Content="🔍 Search" Style="{DynamicResource AccentButton}"
                        Margin="5,0" Click="SearchButton_Click"/>
            </Grid>
        </Border>

        <!-- Status / Info -->
        <TextBlock Grid.Row="2" x:Name="StatusText" 
                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="30,0,30,15"/>

        <!-- Recommended Games -->
        <ScrollViewer Grid.Row="3" Margin="30,0,30,30">
            <StackPanel>
                <TextBlock FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="⭐ Recommended Paid Games" Margin="0,0,0,10"/>

                <ItemsControl x:Name="GamesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBrush}" CornerRadius="12"
                                    Padding="15" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                                            CornerRadius="8" Width="90" Height="120">
                                        <TextBlock Text="🎮" FontSize="40"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding AppId, StringFormat='App ID: {0}'}" 
                                                   FontSize="12"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Margin="0,3,0,0"/>
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="📥 Get Manifest"
                                                    Style="{DynamicResource AccentButton}"
                                                    Tag="{Binding AppId}"
                                                    Click="GetManifest_Click"
                                                    Margin="0,0,8,0"/>
                                            <Button Content="🔗 Open fares.top"
                                                    Style="{DynamicResource AccentButton}"
                                                    Tag="{Binding ManifestUrl}"
                                                    Click="OpenFaresTop_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="⭐" FontSize="24" 
                                               VerticalAlignment="Top" Margin="5"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- If no games loaded -->
                <Border x:Name="NoGamesPanel" Background="{DynamicResource CardBrush}"
                        CornerRadius="12" Padding="30" Margin="0,10,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🕹️" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="Loading Steam recommendations..." 
                                   FontSize="16" Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        <Button Content="🔄 Refresh Recommendations"
                                Style="{DynamicResource AccentButton}"
                                HorizontalAlignment="Center" Margin="0,15,0,0"
                                Click="RefreshBtn_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>



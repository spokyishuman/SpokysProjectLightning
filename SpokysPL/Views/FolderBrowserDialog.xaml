<Window x:Class="SpokysProjectLightning.Views.FolderBrowserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Folder"
        Height="460" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TreeView x:Name="Tree" Grid.Row="0" Margin="0,0,0,12"
                  Background="{DynamicResource SurfaceBrush}"
                  Foreground="{DynamicResource TextPrimaryBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="OkBtn" Content="Select" Width="100" Margin="0,0,10,0"
                    Style="{DynamicResource AccentButton}" Click="Ok_Click"/>
            <Button x:Name="CancelBtn" Content="Cancel" Width="100"
                    Style="{DynamicResource SecondaryButton}" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>



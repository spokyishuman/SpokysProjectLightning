<UserControl x:Class="SpokysProjectVercel.Views.OpenSteamToolPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             Background="Transparent">
    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="🔧 OpenSteamTool" FontSize="28" FontWeight="Bold" FontStyle="Italic"
                       Foreground="{DynamicResource PrimaryBrush}"
                       Effect="{DynamicResource TextGlow}" VerticalAlignment="Center"/>
            <Border x:Name="VersionBadge" Background="#264ADE80" CornerRadius="6"
                    Padding="10,4" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="VersionText" Text="Checking..." FontSize="12"
                           Foreground="{DynamicResource PrimaryBrush}" FontWeight="Bold"/>
            </Border>
            <Button x:Name="RefreshBtn" Content="🔄" Width="30" Height="30"
                    Style="{DynamicResource IconNavButton}" Margin="8,0,0,0"
                    ToolTip="Refresh status" Click="RefreshBtn_Click"/>
            <Button x:Name="OpenSteamDirBtn" Content="📂 Steam Folder" 
                    Style="{DynamicResource SecondaryButton}" Padding="10,5" FontSize="11"
                    Margin="8,0,0,0" Click="OpenSteamDirBtn_Click"/>
            <Button x:Name="OpenLuaDirBtn" Content="📂 Lua Folder"
                    Style="{DynamicResource SecondaryButton}" Padding="10,5" FontSize="11"
                    Margin="8,0,0,0" Click="OpenLuaDirBtn_Click"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- STATUS & INSTALL -->
                <Border Background="{DynamicResource CardBrush}" CornerRadius="12"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Padding="20" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Width="48" Height="48" CornerRadius="10"
                                Background="#26FF5722" Margin="0,0,16,0"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="StatusIcon" Text="❓" FontSize="22"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusTitle" Text="Checking installation..."
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="StatusSubtitle" Text="Querying GitHub releases..."
                                       FontSize="12" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button x:Name="InstallBtn" Content="⬇ Install / Update"
                                    Style="{DynamicResource AccentButton}" Padding="16,8"
                                    FontSize="13" Margin="0,0,8,0"
                                    Click="InstallBtn_Click"/>
                            <Button x:Name="UninstallBtn" Content="🗑 Remove DLLs"
                                    Style="{DynamicResource SecondaryButton}" Padding="10,8"
                                    FontSize="11" Click="UninstallBtn_Click"/>
                        </StackPanel>

                        <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0">
                            <Border x:Name="InstalledBadge" Background="#1A4CAF50" CornerRadius="4"
                                    Padding="8,3" Margin="0,0,8,4">
                                <TextBlock x:Name="InstalledText" Text="" FontSize="11"
                                           Foreground="#4CAF50"/>
                            </Border>
                            <Border x:Name="PatternBadge" Background="#1AFF9800" CornerRadius="4"
                                    Padding="8,3" Margin="0,0,8,4">
                                <TextBlock x:Name="PatternText" Text="" FontSize="11"
                                           Foreground="#FF9800"/>
                            </Border>
                            <Border x:Name="LuaCountBadge" Background="#1A2196F3" CornerRadius="4"
                                    Padding="8,3" Margin="0,0,8,4">
                                <TextBlock x:Name="LuaCountText" Text="" FontSize="11"
                                           Foreground="#2196F3"/>
                            </Border>
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- TABS -->
                <Border Background="{DynamicResource CardBrush}" CornerRadius="12"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Padding="0" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0"
                                    Background="{DynamicResource SurfaceBrush}">
                            <Button x:Name="TabLua" Content="📜 Lua Configs" FontSize="13"
                                    Cursor="Hand" Padding="16,10" Margin="0"
                                    BorderThickness="0" Background="Transparent"
                                    Foreground="{DynamicResource PrimaryBrush}"
                                    Click="TabLua_Click"/>
                            <Button x:Name="TabToml" Content="⚙ TOML Config" FontSize="13"
                                    Cursor="Hand" Padding="16,10" Margin="0"
                                    BorderThickness="0" Background="Transparent"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Click="TabToml_Click"/>
                            <Button x:Name="TabLogs" Content="📋 Log Viewer" FontSize="13"
                                    Cursor="Hand" Padding="16,10" Margin="0"
                                    BorderThickness="0" Background="Transparent"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    Click="TabLogs_Click"/>
                        </StackPanel>

                        <!-- TAB: Lua Configs -->
                        <Grid x:Name="LuaPanel" Grid.Row="1" Margin="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Lua scripts in &lt;Steam&gt;/config/lua/"
                                           FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Button Content="➕ New Lua" Padding="10,5" FontSize="11"
                                        Style="{DynamicResource SecondaryButton}"
                                        Click="NewLuaBtn_Click" Margin="0,0,8,0"/>
                            <Button Content="📦 Batch from DB" Padding="10,5" FontSize="11"
                                        Style="{DynamicResource SecondaryButton}"
                                        Click="BatchFromDbBtn_Click" Margin="0,0,8,0"/>
                            <Button x:Name="DeleteLuaBtn" Content="🗑 Delete Selected"
                                        Padding="10,5" FontSize="11"
                                        Style="{DynamicResource SecondaryButton}"
                                        Click="DeleteLuaBtn_Click"/>
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ListBox x:Name="LuaListBox" Grid.Column="0"
                                         DisplayMemberPath="FileName"
                                         Background="{DynamicResource SurfaceBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         SelectionChanged="LuaListBox_SelectionChanged"/>
                                <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource BorderBrush}" Margin="12,0"/>
                                <TextBox x:Name="LuaEditor" Grid.Column="2"
                                         FontFamily="Consolas" FontSize="12"
                                         Background="{DynamicResource SurfaceBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}"
                                         AcceptsReturn="True" AcceptsTab="True"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         SpellCheck.IsEnabled="False"/>
                            </Grid>
                        </Grid>

                        <!-- TAB: TOML Config -->
                        <Grid x:Name="TomlPanel" Grid.Row="1" Margin="20" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="opensteamtool.toml configuration"
                                           FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button Content="📄 Load Default" Padding="10,5" FontSize="11"
                                        Style="{DynamicResource SecondaryButton}"
                                        Click="LoadDefaultTomlBtn_Click" Margin="0,0,8,0"/>
                                <Button Content="💾 Save" Padding="14,5" FontSize="11"
                                        Style="{DynamicResource AccentButton}"
                                        Click="SaveTomlBtn_Click"/>
                            </StackPanel>
                            <TextBox x:Name="TomlEditor" Grid.Row="1"
                                     FontFamily="Consolas" FontSize="12"
                                     Background="{DynamicResource SurfaceBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     AcceptsReturn="True" AcceptsTab="True"
                                     TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto"
                                     SpellCheck.IsEnabled="False"/>
                        </Grid>

                        <!-- TAB: Logs -->
                        <Grid x:Name="LogsPanel" Grid.Row="1" Margin="20" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="OpenSteamTool debug logs from &lt;Steam&gt;/opensteamtool/"
                                           FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button Content="🔄 Refresh Logs" Padding="10,5" FontSize="11"
                                        Style="{DynamicResource SecondaryButton}"
                                        Click="RefreshLogsBtn_Click"/>
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ListBox x:Name="LogListBox" Grid.Column="0"
                                         Background="{DynamicResource SurfaceBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         SelectionChanged="LogListBox_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding FileName}" FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding SizeDisplay}" FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource BorderBrush}" Margin="12,0"/>
                                <TextBox x:Name="LogViewer" Grid.Column="2"
                                         FontFamily="Consolas" FontSize="11"
                                         Background="{DynamicResource SurfaceBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}"
                                         IsReadOnly="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         TextWrapping="NoWrap"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

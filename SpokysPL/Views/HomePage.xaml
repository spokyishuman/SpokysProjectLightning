<UserControl x:Class="SpokysProjectVercel.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:SpokysProjectVercel.Models"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1200"
             Background="Transparent">

    <UserControl.Resources>
        <Style x:Key="GameCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect" Value="{DynamicResource CardShadow}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Color="{DynamicResource AccentColor}" Opacity="0.55"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuickLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#144ADE80" CornerRadius="12"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                              TextBlock.FontWeight="{TemplateBinding FontWeight}"
                                              TextBlock.FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2A4ADE80"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="20" ShadowDepth="0"
                                                          Color="{DynamicResource AccentColor}" Opacity="0.35"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,40">
        <StackPanel MaxWidth="1152">
            <!-- ===== HERO ===== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="WELCOME TO" FontSize="48" FontWeight="ExtraBold" FontStyle="Italic"
                               LineHeight="43" Foreground="{DynamicResource TextPrimaryBrush}"
                               TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Text="💀" FontSize="28" Foreground="{DynamicResource PrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="PROJECT VERCEL" FontSize="32" FontWeight="ExtraBold" FontStyle="Italic"
                                   Foreground="{DynamicResource PrimaryBrush}" Margin="8,0">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="0"
                                                  Color="{DynamicResource AccentColor}" Opacity="0.55"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="💀" FontSize="28" Foreground="{DynamicResource PrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Your all-in-one hub to add, manage and fix games. Drop a file or browse the library below to get started."
                               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" MaxWidth="448" Margin="0,16,0,0"/>
                </StackPanel>


            </Grid>

            <!-- ===== FEATURED ===== -->
            <StackPanel Margin="0,40,0,0">
                <Border Style="{DynamicResource SectionHeaderBar}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔥" FontSize="20" Foreground="{DynamicResource PrimaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="Featured" FontSize="18" FontWeight="ExtraBold"
                                   FontStyle="Italic" Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="0"
                                                  Color="{DynamicResource AccentColor}" Opacity="0.55"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Grid>
                </Border>

                <Border Margin="0,12,0,0" CornerRadius="16" BorderThickness="1"
                        BorderBrush="#404ADE80" ClipToBounds="True" Height="260">
                    <Grid>
                        <Image x:Name="FeaturedImage" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                    <GradientStop Offset="0" Color="{DynamicResource BackgroundColor}"/>
                                    <GradientStop Offset="0.4" Color="#66141F19"/>
                                    <GradientStop Offset="1" Color="Transparent"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <StackPanel VerticalAlignment="Bottom" Margin="24,0,24,24">
                            <Border Background="#334ADE80" CornerRadius="6" Padding="8,3"
                                    HorizontalAlignment="Left">
                                <TextBlock x:Name="FeaturedTag" Text="FEATURED" FontSize="11"
                                           FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                            </Border>
                            <TextBlock x:Name="FeaturedTitle" Text="" FontSize="32" FontWeight="ExtraBold"
                                       FontStyle="Italic" Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="📥" FontSize="16" Foreground="{DynamicResource PrimaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="FeaturedDownloads" Text="" FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <Button x:Name="FeaturedPlayBtn" Content="▶ Play" FontSize="12"
                                        Style="{DynamicResource AccentButton}"
                                        Visibility="Collapsed" Margin="12,0,0,0"
                                        Padding="14,6" Click="FeaturedPlay_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ===== MOST DOWNLOADED ===== -->
            <StackPanel Margin="0,32,0,0">
                <Border Style="{DynamicResource SectionHeaderBar}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📥" FontSize="20" Foreground="{DynamicResource PrimaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="Most Downloaded" FontSize="18" FontWeight="ExtraBold"
                                   FontStyle="Italic" Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="0"
                                                  Color="{DynamicResource AccentColor}" Opacity="0.55"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Grid>
                </Border>

                <ItemsControl x:Name="MostDownloadedItems" Margin="0,12,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ManifestInfo}">
                            <Border Style="{StaticResource GameCardStyle}" Width="184" Margin="0,0,16,16"
                                    Tag="{Binding AppId}"
                                    PreviewMouseDown="GameCard_Click">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="📥 Install" Tag="{Binding AppId}" Click="ContextInstall_Click"/>
                                        <MenuItem Header="🌐 Open Steam Page" Tag="{Binding AppId}" Click="ContextOpenSteam_Click"/>
                                        <MenuItem Header="📋 Copy App ID" Tag="{Binding AppId}" Click="ContextCopyId_Click"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="120"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" CornerRadius="14,14,0,0" ClipToBounds="True">
                                        <Grid>
                                            <Border Background="#141F19">
                                                <TextBlock Text="🎮" FontSize="30"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <Border Background="#CC000000" CornerRadius="6" Padding="6,3"
                                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8">
                                                <TextBlock Text="{Binding AppId}" FontSize="10"
                                                           Foreground="White" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Row="1" Margin="10,10,10,12">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="34"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding AppId, StringFormat='📥 App ID: {0}'}" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ===== QUICK LINKS ===== -->
            <Grid Margin="0,32,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.Resources>
                    <Style TargetType="Grid" x:Key="QuickLinkGrid">
                        <Setter Property="Margin" Value="0,0,8,0"/>
                    </Style>
                </Grid.Resources>
                <Button Grid.Column="0" Content="Quick Guide" Style="{DynamicResource QuickLinkButtonStyle}"
                        Margin="0,0,8,0" Click="QuickGuide_Click"/>
                <Button Grid.Column="1" Content="Changelog" Style="{DynamicResource QuickLinkButtonStyle}"
                        Margin="4,0,8,0" Click="Changelog_Click"/>
                <Button Grid.Column="2" Content="Legal Notice" Style="{DynamicResource QuickLinkButtonStyle}"
                        Margin="4,0,8,0" Click="Legal_Click"/>
                <Button Grid.Column="3" Content="About" Style="{DynamicResource QuickLinkButtonStyle}"
                        Margin="4,0,0,0" Click="About_Click"/>
            </Grid>

            <!-- ===== DROP ZONE (install a fix archive) ===== -->
            <Border x:Name="DropZone" Margin="0,32,0,0" CornerRadius="16" BorderThickness="2"
                    BorderBrush="#554ADE80" Background="#1A1B2D22" Padding="24"
                    AllowDrop="True" Drop="DropZone_Drop" DragEnter="DropZone_DragEnter"
                    DragLeave="DropZone_DragLeave" Cursor="Hand">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="📥" FontSize="34" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Drop a fix archive here to install it"
                               FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text=".rar  .zip  .7z  .001 — it will be extracted into your game folder"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>


            </StackPanel>
        </ScrollViewer>

        <!-- Progress side panel -->
        <Border x:Name="ProgressPanel" Visibility="Collapsed"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,12,12,0" Panel.ZIndex="100"
                Background="{DynamicResource CardBrush}" CornerRadius="12"
                BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1"
                Padding="16,12" MaxWidth="340">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ProgressIcon" Text="⏳" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="ProgressText" Text="Working..." FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>



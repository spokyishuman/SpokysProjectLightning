<UserControl x:Class="SpokysProjectLightning.Views.ReportBugPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="800" d:DesignWidth="1200"
      Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" Margin="40,36,40,40">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Border Width="36" Height="36" CornerRadius="10"
                            Background="{DynamicResource PrimaryBrush}" Opacity="0.15"
                            Effect="{DynamicResource NeonRing}" Margin="0,0,12,0">
                        <TextBlock Text="🐛" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="REPORT BUG" FontSize="32" FontWeight="Bold"
                               FontStyle="Italic" Foreground="{DynamicResource PrimaryBrush}"
                               Effect="{DynamicResource TextGlow}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Send bug reports with optional video attachment directly to the developer." FontSize="13"
                           Foreground="{DynamicResource MutedForegroundBrush}" Margin="0,0,0,24"/>
            </StackPanel>

            <Border Style="{DynamicResource ModernCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Describe the bug" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource CardForegroundBrush}" Margin="0,0,0,6"/>
                    <TextBlock FontSize="13" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap"
                               Text="Explain what went wrong. Include steps to reproduce if possible."
                               Margin="0,0,0,14"/>
                    <TextBox x:Name="DescriptionBox" FontSize="13" Height="180"
                             VerticalContentAlignment="Top" Padding="10,8"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             Background="{DynamicResource SurfaceBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Border>

            <Border Style="{DynamicResource ModernCard}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Attach video (optional)" FontSize="17" FontWeight="Bold"
                               Foreground="{DynamicResource CardForegroundBrush}" Margin="0,0,0,6"/>
                    <TextBlock FontSize="13" Foreground="{DynamicResource MutedForegroundBrush}" TextWrapping="Wrap"
                               Text="Record a quick clip showing the issue. MP4, MOV, or AVI — max ~25 MB."
                               Margin="0,0,0,14"/>
                    <Border Background="#331B2D22" CornerRadius="8"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="VideoIcon" Text="🎥" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" x:Name="VideoPathDisplay" FontSize="13" FontFamily="Consolas"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                       Text="No video selected" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="📂 Select Video" Style="{DynamicResource SecondaryButton}"
                                Click="SelectVideo_Click" Margin="0,0,8,0" Padding="12,8"/>
                        <Button x:Name="ClearVideoBtn" Content="✕ Clear" Style="{DynamicResource SecondaryButton}"
                                Click="ClearVideo_Click" Padding="12,8" Visibility="Collapsed"/>
                    </WrapPanel>
                    <TextBlock x:Name="VideoSizeText" Text="" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <WrapPanel HorizontalAlignment="Right" Margin="0,0,0,16">
                <TextBlock x:Name="StatusText" Text="" FontSize="13"
                           Foreground="{DynamicResource PrimaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="SendBtn" Content="🐛 Send Report" Style="{DynamicResource AccentButton}"
                        Click="SendReport_Click" Padding="16,10" FontSize="14"/>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

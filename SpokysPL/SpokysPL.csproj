<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
    <ApplicationIcon>app.ico</ApplicationIcon>
<ApplicationVersion>1.3.4.0</ApplicationVersion>
<AssemblyVersion>1.3.4.0</AssemblyVersion>
<FileVersion>1.3.4.0</FileVersion>
<InformationalVersion>1.3.4.0</InformationalVersion>
    <AssemblyName>SpokysProjectLightning</AssemblyName>
    <RootNamespace>SpokysProjectLightning</RootNamespace>
    <Company>Spoky</Company>
    <Product>Spokys Project Lightning</Product>
    <Description>Game manifest manager and movie streaming app</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SharpCompress" Version="0.50.0" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="data.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="data-fix.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="shop.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="movies.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpokysPL.Updater\SpokysPL.Updater.csproj" ReferenceOutputAssembly="false">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyUpdater" AfterTargets="Build">
    <Copy SourceFiles="..\SpokysPL.Updater\bin\$(Configuration)\net8.0\win-x64\publish\SpokysPL.Updater.exe"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="True" />
  </Target>

  <Target Name="CopyBackgroundVideos" AfterTargets="Build;Publish" Condition="Exists('$(MSBuildProjectDirectory)')">
    <ItemGroup>
      <_Videos Include="$(MSBuildProjectDirectory)\*.mp4;$(MSBuildProjectDirectory)\*.webm;$(MSBuildProjectDirectory)\*.mkv" />
    </ItemGroup>
    <Copy SourceFiles="@(_Videos)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="True" />
    <Copy SourceFiles="@(_Videos)" DestinationFolder="$(OutputPath)publish\" SkipUnchangedFiles="True" Condition="Exists('$(OutputPath)publish\')" />
  </Target>

</Project>
